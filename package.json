{
  "name": "@lp-labs/react-filter-builder",
  "version": "0.1.0",
  "description": "Typed recursive React filters with validated JSON and deterministic evaluation.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs && npm run test:types",
    "test:types": "tsc --noEmit --strict --skipLibCheck false --module NodeNext --moduleResolution NodeNext --target ES2020 --lib ES2020,DOM --types react tests\\consumer.mts tests\\consumer.cts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.3"
  },
  "license": "MIT",
  "author": {
    "name": "Libin Prasanth",
    "url": "https://www.linkedin.com/in/libinprasanth/"
  },
  "funding": {
    "type": "paypal",
    "url": "https://www.paypal.me/LibinPrasanth"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "react",
    "filter",
    "query-builder",
    "typescript"
  ]
}
